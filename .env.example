# Optional: Add your Hugging Face API token for enhanced translation features
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Optional: Base URL for API calls (defaults to http://localhost:3000 in development)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (data layer + auth). See supabase/migrations/0001_init.sql for
# the schema. Run `npx supabase start` locally to boot the stack, then copy
# the printed URL / anon / service-role keys into .env.local.
# ---------------------------------------------------------------------------

# Public project URL — exposed to the browser bundle (safe).
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous (publishable) API key — exposed to the browser bundle (safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-ONLY. Never expose to the browser. Treat this
# like a database password: it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to run __tests__/rls.test.ts against your local Supabase stack.
# Leave empty in normal dev/CI so `npm test` skips the suite.
# SUPABASE_LOCAL=1

# ---------------------------------------------------------------------------
# External data sources (Stream D — song lookup / enrichment).
#
# All three blocks below are independently optional. Missing keys cause the
# `/api/songs/*` routes to return a clean 503 with a JSON error, never a
# crash. The MusicBrainz + AcousticBrainz adapters need no credentials.
# ---------------------------------------------------------------------------

# Spotify Web API — Client Credentials flow only (no user OAuth needed for
# search / metadata / 30s preview). Create an app at
# https://developer.spotify.com/dashboard, then copy the Client ID / Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API — used for metadata only (cover art, album, producer credits,
# link-out URL). We deliberately never fetch the lyrics HTML; see the comment
# at the top of lib/sources/genius.ts for the ToS reasoning. Generate a
# Client Access Token at https://genius.com/api-clients.
GENIUS_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Identify (song identification) — both blocks optional.
# ---------------------------------------------------------------------------

# AudD music recognition — the world-catalog fallback when a mic snippet
# doesn't match our own constellation fingerprint catalog. Per-request cost;
# the relay route is rate-limited and only called after user consent.
# Without a token the fallback is skipped cleanly ("not in catalog yet").
# Get a token at https://audd.io.
AUDD_API_TOKEN=

# Upstash Redis — global rate limiting for /api/identify, /api/analyze,
# /api/songs/search, /api/translate and /api/fingerprints. Without these,
# an in-memory per-instance sliding window applies instead (weaker, fine
# for dev). Create a database at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
